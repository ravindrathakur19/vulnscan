# Copy to terraform.tfvars and fill in your own values. Never commit terraform.tfvars.
aws_region           = "ap-south-1"
project_name         = "vulnscan-pro"
instance_type        = "t3.micro"
root_volume_size_gb  = 20
key_pair_name        = "vulnscan-key"     # must already exist in the target AWS account/region
ssh_cidr             = "203.0.113.4/32"   # YOUR IP only - run `curl -s ifconfig.me` to find it
allowed_http_cidr    = "0.0.0.0/0"
