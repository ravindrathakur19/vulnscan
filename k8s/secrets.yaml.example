# Copy to secrets.yaml, fill in a real secret, and apply it yourself.
# NEVER commit secrets.yaml (it's in .gitignore). Generate a strong key with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
apiVersion: v1
kind: Secret
metadata:
  name: vulnscan-secrets
  namespace: vulnscan
type: Opaque
stringData:
  SECRET_KEY: "REPLACE_WITH_A_LONG_RANDOM_VALUE"
